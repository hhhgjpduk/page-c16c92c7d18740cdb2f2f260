.35fr) minmax(0,1fr);gap:32px;align-items:end;padding-bottom:28px;border-bottom:2px solid var(--line)}\n  .hero-head h1{font-size:clamp(34px,5.4vw,62px);font-weight:800;letter-spacing:-0.02em}\n  .hero-head h1 em{font-style:normal;color:var(--orange)}\n  .hero-side p{font-size:15px;color:var(--muted);margin-bottom:0}\n  .dash{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:0;border:2px solid var(--line);border-top:none}\n  .dash .cell{padding:20px 18px 22px;border-right:2px solid var(--line);min-height:132px}\n  .dash .cell:last-child{border-right:none}\n  .dash .cell .tag{font-size:11px;font-weight:700;letter-spacing:0.16em;color:var(--muted);text-transform:uppercase}\n  .dash .cell .num{font-size:34px;font-weight:800;letter-spacing:-0.02em;line-height:1.1;margin:10px 0 4px}\n  .dash .cell .num small{font-size:14px;font-weight:600;letter-spacing:0}\n  .dash .cell .sub{font-size:13px;color:var(--muted);line-height:1.55}\n  .dash .cell.accent{background:var(--orange);color:#fff;border-color:var(--line)}\n  .dash .cell.accent .tag,\n  .dash .cell.accent .sub{color:#fff;opacity:.86}\n  .hero-foot{display:flex;flex-wrap:wrap;gap:12px 28px;align-items:center;padding:18px 0 0;font-size:14px;color:var(--muted)}\n  .hero-foot a{font-weight:700;text-decoration:none;border-bottom:2px solid var(--orange);padding-bottom:1px}\n  /* ---------- 粗描边直角卡片 ---------- */\n  .board{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:20px;margin-top:24px}\n  .card{border:2px solid var(--line);padding:22px 20px 24px;background:#fff}\n  .card .idx{display:inline-block;font-size:12px;font-weight:800;letter-spacing:0.1em;color:var(--orange);margin-bottom:10px}\n  .card h3{margin-bottom:8px}\n  .card p{font-size:14px;color:var(--muted);margin-bottom:0}\n  /* ---------- 套餐横向对比表 ---------- */\n  .table-wrap{margin-top:22px;overflow-x:auto;border:2px solid var(--line)}\n  table{border-collapse:collapse;width:100%;min-width:660px;font-size:14px}\n  caption{caption-side:top;text-align:left;font-size:13px;color:var(--muted);padding:12px 16px;border-bottom:2px solid var(--line);background:var(--soft)}\n  th,td{padding:14px 16px;text-align:left;border-bottom:1px solid #dcdcd8;vertical-align:top}\n  thead th{background:var(--soft);font-size:13px;letter-spacing:0.06em;border-bottom:2px solid var(--line);white-space:nowrap}\n  thead th.hot{background:var(--orange);color:#fff}\n  tbody th{font-weight:600;white-space:nowrap;width:150px;color:var(--muted);font-size:13px}\n  td.pick{background:#fff5f0}\n  .price{font-size:20px;font-weight:800;letter-spacing:-0.01em}\n  .price small{font-size:12px;font-weight:600;color:var(--muted)}\n  .badge{display:inline-block;font-size:11px;font-weight:800;letter-spacing:0.1em;color:#fff;background:var(--orange);padding:2px 7px;margin-bottom:6px}\n  ul.feats{list-style:none;margin:0;padding:0}\n  ul.feats li{font-size:13.5px;line-height:1.6;padding-left:14px;position:relative}\n  ul.feats li::before{content:\"\";position:absolute;left:0;top:9px;width:6px;height:6px;background:var(--orange)}\n  .table-note{font-size:13px;color:var(--muted);margin-top:14px;max-width:60ch}\n  /* ---------- 使用说明 ---------- */\n  .steps{list-style:none;margin:24px 0 0;padding:0;display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:0;border:2px solid var(--line)}\n  .steps li{padding:22px 20px 24px;border-right:2px solid var(--line)}\n  .steps li:last-child{border-right:none}\n  .steps .n{font-size:13px;font-weight:800;letter-spacing:0.14em;color:var(--orange);display:block;margin-bottom:10px}\n  .steps h3{margin-bottom:6px;font-size:16px}\n  .steps p{font-size:14px;color:var(--muted);margin-bottom:0}\n  /* ---------- 客户端 ---------- */\n  .clients{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:20px;margin-top:24px}\n  .client{border:2px solid var(--line);border-top:8px solid var(--orange);padding:20px}\n  .client h3{margin-bottom:6px}\n  .client p{font-size:14px;color:var(--muted);margin-bottom:10px}\n  .client .meta{font-size:12px;color:var(--muted);border-top:1px dashed #c9c9c4;padding-top:10px;margin-top:auto}\n  .client a{display:inline-block;font-size:13px;font-weight:700;text-decoration:none;border-bottom:2px solid var(--orange)}\n  /* ---------- FAQ 双栏 ---------- */\n  .faq-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:0 40px;margin-top:24px;border-top:2px solid var(--line);padding-top:8px}\n  .qa{padding:20px 0 18px;border-bottom:1px solid #dcdcd8}\n  .qa h3{font-size:15.5px;margin-bottom:8px;display:flex;gap:10px}\n  .qa h3 .q{color:var(--orange);font-weight:800;flex:0 0 auto}\n  .qa p{font-size:14px;color:var(--muted);margin:0 0 0 26px}\n  /* ---------- 页脚 ---------- */\n  footer{border-top:2px solid var(--line);padding:26px 0 0;font-size:13px;color:var(--muted);display:flex;flex-wrap:wrap;gap:8px 26px;justify-content:space-between}\n  /* ---------- 手机适配 ---------- */\n  @media (max-width:900px){.shell{\n      grid-template-columns:1fr;padding:0 18px;gap:0;}\n    .rail{\n      position:static;height:auto;border-right:none;border-bottom:2px solid var(--line);padding:22px 0 14px;flex-direction:row;flex-wrap:wrap;align-items:center;gap:12px 20px;justify-content:flex-start;}\n    .rail .mark{font-size:20px;}\n    .rail .mark span{display:inline;margin-left:8px;font-size:10px;}\n    .rail nav{margin-left:auto;}\n    .rail nav ul{\n      display:flex;flex-wrap:wrap;gap:2px 14px;margin:0;}\n    .rail nav a{padding:4px 0;border-left:none;border-bottom:2px solid transparent;padding-left:0;}\n    .rail nav a:hover,.rail nav a:focus{border-left-color:transparent;border-bottom-color:var(--orange);}\n    .rail .note{display:none;}\n    main{padding:26px 0 64px;}\n    .hero-head{grid-template-columns:1fr;align-items:start;gap:16px;padding-bottom:22px;}\n    .dash{grid-template-columns:repeat(2,minmax(0,1fr));}\n    .dash .cell:nth-child(2){border-right:none;}\n    .dash .cell:nth-child(1),\n    .dash .cell:nth-child(2){border-bottom:2px solid var(--line);}\n    .faq-grid{grid-template-columns:1fr;gap:0;}\n    .steps li{border-right:none;border-bottom:2px solid var(--line);}\n    .steps li:last-child{border-bottom:none;}\n    h2{font-size:22px;}}\n</style><div class=\"shell\">\n\n  <aside class=\"rail\">\n    <div class=\"mark\">XLM<span>使用说明与订阅</span></div>\n    <nav aria-label=\"页面目录\">\n      <ul>\n        <li><a href=\"#overview\">一眼看清</a></li>\n        <li><a href=\"#plans\">套餐对比</a></li>\n        <li><a href=\"#how\">怎么开始</a></li>\n        <li><a href=\"#clients\">客户端</a></li>\n        <li><a href=\"#faq\">常见问题</a></li>\n      </ul>\n    </nav>\n    <p class=\"note\">这一页把能讲清楚的事都讲了。没讲到的，你可以直接问我们。</p>\n  </aside>\n\n  <main>\n\n    <section class=\"hero\" id=\"overview\">\n      <div class=\"hero-head\">\n        <div>\n          <span class=\"kicker\">XLM · 订阅说明</span>\n          <h1>XLM · 选一个不后悔的档位，<em>然后安心用</em></h1>\n        </div>\n        <div class=\"hero-side\">\n          <p>XLM 这一页不卖关子。三档订阅的差别、客户端怎么装、遇到问题找谁——都摊开写在这里。看完再决定，也没什么损失。</p>\n        </div>\n      </div>\n\n      <div class=\"dash\" role=\"list\">\n        <div class=\"cell accent\" role=\"listitem\">\n          <span class=\"tag\">档位</span>\n          <div class=\"num\">3 <small>档</small></div>\n          <div class=\"sub\">基础、旗舰、团队，按设备数与流量区分。</div>\n        </div>\n        <div class=\"cell\" role=\"listitem\">\n          <span class=\"tag\">设备上限</span>\n          <div class=\"num\">3–20 <small>台</small></div>\n          <div class=\"sub\">从一个人用到一整个小组，都留了位置。</div>\n        </div>\n        <div class=\"cell\" role=\"listitem\">\n          <span class=\"tag\">流量档位</span>\n          <div class=\"num\">100–1000 <small>GB/月</small></div>\n          <div class=\"sub\">按月计量，选档前先想想你一个月用多少。</div>\n        </div>\n        <div class=\"cell\" role=\"listitem\">\n          <span class=\"tag\">计费方式</span>\n          <div class=\"num\">月 / 年</div>\n          <div class=\"sub\">月付灵活，年付划算，随你习惯。</div>\n        </div>\n      </div>\n\n      <div class=\"hero-foot\">\n        <span>不确定选哪档？先跳到 <a href=\"#plans\">套餐对比</a>，横向看一遍再说。</span>\n      </div>\n    </section>\n\n    <section id=\"plans\">\n      <span class=\"kicker\">Plans</span>\n      <h2>三档订阅，横向摆开看</h2>\n      <p class=\"lead\">同一张表里比较，省得来回翻页。旗舰版是大多数人的落点，但基础版和团队版也各有各的用处。</p>\n\n      <div class=\"table-wrap\">\n        <table>\n          价格与权益以本表为准；年付价格按 12 个月一次性结算。\n          <thead>\n            <tr>\n              <th>对比项</th>\n              <th>基础版</th>\n              <th class=\"hot\">旗舰版 · 推荐</th>\n              <th>团队版</th>\n            </tr>\n          </thead>\n          <tbody>\n            <tr>\n              <th>月付价格</th>\n              <td><span class=\"price\">¥15</span><small> /月</small></td>\n              <td class=\"pick\"><span class=\"badge\">推荐</span><br><span class=\"price\">¥35</span><small> /月</small></td>\n              <td><span class=\"price\">¥85</span><small> /月</small></td>\n            </tr>\n            <tr>\n              <th>年付价格</th>\n              <td>¥150 / 年</td>\n              <td class=\"pick\">¥350 / 年</td>\n              <td>¥850 / 年</td>\n            </tr>\n            <tr>\n              <th>每月流量</th>\n              <td>100GB</td>\n              <td class=\"pick\">300GB</td>\n              <td>1000GB</td>\n            </tr>\n            <tr>\n              <th>同时在线设备</th>\n              <td>3 台</td>\n              <td class=\"pick\">5 台</td>\n              <td>20 台</td>\n            </tr>\n            <tr>\n              <th>主要权益</th>\n              <td>\n                <ul class=\"feats\">\n                  <li>解锁基础流媒体</li>\n                  <li>普通线路节点池</li>\n                </ul>\n              </td>\n              <td class=\"pick\">\n                <ul class=\"feats\">\n                  <li>全节点原生流媒体解锁</li>\n                  <li>IPLC 专线游戏加速优化</li>\n                  <li>7×24 优先工单支持</li>\n                </ul>\n              </td>\n              <td>\n                <ul class=\"feats\">\n                  <li>VIP 专属高带宽节点</li>\n                  <li>支持企业定制路由</li>\n                  <li>专属客户经理服务</li>\n                </ul>\n              </td>\n            </tr>\n            <tr>\n              <th>适合谁</th>\n              <td>一个人日常刷网页、看剧，设备不多。</td>\n              <td class=\"pick\">手机加电脑加平板，还想打游戏顺畅一点。</td>\n              <td>小团队共用，需要统一管理和更高带宽。</td>\n            </tr>\n          </tbody>\n        </table>\n      </div>\n\n      <p class=\"table-note\">订阅变更、续费与发票相关事宜，请通过页面下方给出的联系方式与我们确认，本页不提供在线支付入口。</p>\n    </section>\n\n    <section id=\"how\">\n      <span class=\"kicker\">Getting started</span>\n      <h2>四步走完，就能开始用</h2>\n      <p class=\"lead\">没有隐藏步骤。按顺序做，中间卡住了随时回来查这一节。</p>\n\n      <ol class=\"steps\">\n        <li>\n          <span class=\"n\">STEP 01</span>\n          <h3>先想清楚用多少</h3>\n          <p>数一数你手上有几台设备会同时连，再估一下每月大概用掉多少流量。这两个数字决定档位，比看价格更靠谱。</p>\n        </li>\n        <li>\n          <span class=\"n\">STEP 02</span>\n          <h3>挑一档并确认</h3>\n          <p>对照上面的表选一档，把月付还是年付也定下来。拿不定主意就先月付，用满一个月再换成年付也不迟。</p>\n        </li>\n        <li>\n          <span class=\"n\">STEP 03</span>\n          <h3>装上对应客户端</h3>\n          <p>看你用什么设备，到「客户端」一节找对应的系统。装好之后，把订阅信息填进去即可。</p>\n        </li>\n        <li>\n          <span class=\"n\">STEP 04</span>\n          <h3>遇到问题先看 FAQ</h3>\n          <p>多半的问题在常见问题里已经有答案。真没找到，再联系我们，把现象说清楚，我们能省下不少来回。</p>\n        </li>\n      </ol>\n    </section>\n\n    <section id=\"clients\">\n      <span class=\"kicker\">Clients</span>\n      <h2>客户端，按你的设备来</h2>\n      <p class=\"lead\">我们不自建客户端，也不在这里放下载链接——请以你所用设备的官方应用渠道为准，安装前多看一眼来源。</p>\n\n      <div class=\"clients\">\n        <div class=\"client\">\n          <h3>桌面端</h3>\n          <p>Windows 与 macOS 各有对应客户端，安装后填入订阅信息即可使用。</p>\n          <div class=\"meta\">获取方式：请从你所选客户端的官方渠道下载。</div>\n        </div>\n        <div class=\"client\">\n          <h3>移动端</h3>\n          <p>iOS 与 Android 各自的应用商店是首选渠道，注意核对开发者名称。</p>\n          <div class=\"meta\">获取方式：以应用商店的官方条目为准。</div>\n        </div>\n        <div class=\"client\">\n          <h3>订阅信息填写</h3>\n          <p>客户端通常支持链接导入或手动填写，具体字段以客户端提示为准，我们不在此复述界面细节。</p>\n          <div class=\"meta\">如遇填写格式问题，可参考客户端内的说明文档。</div>\n        </div>\n        <div class=\"client\">\n          <h3>设备数核对</h3>\n          <p>接入前确认在线设备数没有超过你所在档位的上限，超出的设备会被挤下线。</p>\n          <div class=\"meta\">各档上限见套餐对比表。</div>\n        </div>\n      </div>\n    </section>\n\n    <section id=\"faq\">\n      <span class=\"kicker\">FAQ</span>\n      <h2>常见问题，左边看，右边也有</h2>\n      <p class=\"lead\">这些问题被问得最多，我们把答案写完整，省得你发消息等回复。</p>\n\n      <div class=\"faq-grid\">\n        <article class=\"qa\">\n          <h3><span class=\"q\">Q</span>三档之间最本质的区别是什么？</h3>\n          <p>主要是三件事：每月流量、同时在线设备数、以及线路与支持的等级。基础版够日常使用；旗舰版在流量、设备数和线路优化上更宽裕；团队版面向多人共用，设备和流量都给得更多，另有定制路由与专人对接。</p>\n        </article>\n\n        <article class=\"qa\">\n          <h3><span class=\"q\">Q</span>我应该选月付还是年付？</h3>\n          <p>第一次用建议先月付，确认日常体验符合预期后再转年付。年付是按 12 个月一次性结算，单价更低，但灵活性也相应降低，请按自己的使用确定性来定。</p>\n        </article>\n\n        <article class=\"qa\">\n          <h3><span class=\"q\">Q</span>设备数上限是怎么算的？</h3>\n          <p>按同一时间在线连接的设备数量计算，不是说你有几台设备就只能注册几台。基础版 3 台、旗舰版 5 台、团队版 20 台。手机和电脑同时在线，就算两台。</p>\n        </article>\n\n        <article class=\"qa\">\n          <h3><span class=\"q\">Q</span>流量用超了会怎样？</h3>\n          <p>每月流量按周期计量，超出后当月的可用情况会受限。具体处理方式请与我们确认，本页不代你承诺任何补偿条款。如果你经常贴着上限用，说明该往上调一档了。</p>\n        </article>\n\n        <article class=\"qa\">\n          <h3><span class=\"q\">Q</span>可以从一档换到另一档吗？</h3>\n          <p>可以提出变更，但涉及计费周期与差价的部分需要人工确认，规则以届时沟通的结果为准。本页不做在线下单，请通过官方联系渠道说明你的情况。</p>\n        </article>\n\n        <article class=\"qa\">\n          <h3><span class=\"q\">Q</span>你们提供退款吗？</h3>\n          <p>本页面不承诺任何退款政策。相关安排请在与我们沟通时直接询问，以届时给出的答复为准，不要依据本页内容自行推定。</p>\n        </article>\n\n        <article class=\"qa\">\n          <h3><span class=\"q\">Q</span>客户端从哪里下载？</h3>\n          <p>我们不在本页提供下载链接。请以你所用设备对应客户端的官方发布渠道为准，安装前核对来源与开发者信息，避免从不明站点获取安装包。</p>\n        </article>\n\n        <article class=\"qa\">\n          <h3><span class=\"q\">Q</span>连不上时我该先检查什么？</h3>\n          <p>按顺序排查：订阅信息是否填写正确、当前在线设备数是否已达上限、本地网络本身是否正常、客户端是否为较新版本。把这几项确认完，多数问题就能定位。仍无法解决时，把现象和报错内容整理清楚再联系我们。</p>\n        </article>\n\n        <article class=\"qa\">\n          <h3><span class=\"q\">Q</span>团队版适合什么样的使用场景？</h3>\n          <p>几个人共用、需要统一管理、对带宽和线路稳定性要求更高的时候。它提供 20 台设备同时在线、每月 1000GB 流量、VIP 专属高带宽节点、企业定制路由和专属客户经理。人数不多的话，旗舰版往往更划算。</p>\n        </article>\n\n        <article class=\"qa\">\n          <h3><span class=\"q\">Q</span>你们会记录我的使用记录吗？</h3>\n          <p>本页不对此作出承诺或描述，因为任何涉及日志与数据处理的说明都应以正式条款为准。如需了解，请直接向我们索取相关说明，不要以本页内容作为依据。</p>\n        </article>\n      </div>\n    </section>\n\n    <footer>\n      <span>XLM · 订阅说明页</span>\n      <span>价格与权益以套餐对比表为准，其他事项请与我们沟通确认。</span>\n    </footer>\n\n  </main>\n</div>",
